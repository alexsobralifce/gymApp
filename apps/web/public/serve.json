{
  "cleanUrls": [
    "!/googledca*"
  ],
  "rewrites": [
    {
      "source": "/{login,auth,academias,alterar-senha,alunos,amizades,avaliacoes,avaliacoes-sistema,beneficios,biblioteca-planos,billing,clubes,dados,documentacao,evolucao,exercicios,feed,fichas,financeiro,medidas,meus-treinos,mural,notificacoes,onboarding,parceiros,paywall,privacidade,professores,promocoes,social,publicacoes,treino,treinos,usuarios,vinculos,welcome}",
      "destination": "/index.html"
    },
    {
      "source": "/{login,auth,academias,alterar-senha,alunos,amizades,avaliacoes,avaliacoes-sistema,beneficios,biblioteca-planos,billing,clubes,dados,documentacao,evolucao,exercicios,feed,fichas,financeiro,medidas,meus-treinos,mural,notificacoes,onboarding,parceiros,paywall,privacidade,professores,promocoes,social,treino,treinos,usuarios,vinculos,welcome}/**",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/{icon*,favicon*,app-icon*,feature-graphic*}",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
