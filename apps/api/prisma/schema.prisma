generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                       String            @id @default(cuid())
  email                    String            @unique
  senha_hash               String?
  nome                     String
  role                     Role
  foto_url                 String?
  criado_em                DateTime          @default(now())
  atualizado_em            DateTime          @updatedAt
  expo_push_token          String?
  web_push_subscription    Json?
  telefone                 String?
  ativo                    Boolean           @default(true)
  admin                    Boolean           @default(false)
  email_verified           Boolean           @default(false)
  email_verify_code        String?
  email_verify_code_expira DateTime?
  reset_password_code        String?
  reset_password_code_expira DateTime?
  google_id                String?           @unique
  academia                 Academia?
  aluno                    Aluno?
  avaliacoesAvalidadas     AvaliacaoFisica[]
  professor                Professor?
  refreshTokens            RefreshToken[]
  ultima_atividade_em      DateTime?
  proxima_noticia_em       DateTime?
  preferencias_notificacao Json?
  noticiasEnviadas         NoticiaEnviada[]
  assinaturas              Assinatura[]
  premium_manual_em        DateTime?
  premium_manual_por       String?
  premium_manual_nota      String?
  convitesCriados          ConviteAluno[]             @relation("ConvitesCriados")
  conviteUtilizado         ConviteAluno?              @relation("ConviteUtilizado")
  instagram_user_id        String?                    @unique
  instagram_token          String?
  instagram_token_expira   DateTime?
  facebook_page_id         String?
  metodosPagamento         PagamentoMetodo[]

  @@map("usuarios")
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  usuario_id String
  expira_em  DateTime
  criado_em  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Academia {
  id               String              @id @default(cuid())
  usuario_id       String              @unique
  nome             String
  cnpj             String              @unique
  status           AcademiaStatus      @default(PENDENTE)
  max_professores  Int                 @default(20)
  rejeitado_motivo String?
  criado_em        DateTime            @default(now())
  atualizado_em    DateTime            @updatedAt
  usuario          Usuario             @relation(fields: [usuario_id], references: [id])
  alunos           Aluno[]
  professores      ProfessorAcademia[]

  @@map("academias")
}

model Professor {
  id            String              @id @default(cuid())
  usuario_id    String              @unique
  cref          String?
  criado_em     DateTime            @default(now())
  atualizado_em DateTime            @updatedAt
  alunos        Aluno[]
  academias     ProfessorAcademia[]
  usuario       Usuario             @relation(fields: [usuario_id], references: [id])

  @@map("professores")
}

/// Vínculo M:N com aprovação em duas camadas
model ProfessorAcademia {
  id            String        @id @default(cuid())
  professor_id  String
  academia_id   String
  status        VinculoStatus @default(PENDENTE_ACADEMIA)
  criado_em     DateTime      @default(now())
  atualizado_em DateTime      @updatedAt
  academia      Academia      @relation(fields: [academia_id], references: [id])
  professor     Professor     @relation(fields: [professor_id], references: [id])

  @@unique([professor_id, academia_id])
  @@map("professor_academia")
}

model Aluno {
  id                       String                        @id @default(cuid())
  usuario_id               String                        @unique
  professor_id             String?
  academia_id              String?
  criado_em                DateTime                      @default(now())
  atualizado_em            DateTime                      @updatedAt
  altura_cm                Float?
  consentiu_feed_social_em DateTime?
  data_nascimento          DateTime?
  /// Triagem simplificada PAR-Q+ coletada no cadastro (UX-009)
  parq_respostas           Json?
  meta_semanal             Int                           @default(3)
  permite_busca_email      Boolean                       @default(true)
  peso_kg                  Float?
  sexo                     Sexo?
  visibilidade_padrao      Visibilidade                  @default(AMIGOS)
  nivel_treino             String?
  objetivo_treino          String?
  restricoes               String[]                      @default([])
  academia                 Academia?                     @relation(fields: [academia_id], references: [id])
  professor                Professor?                    @relation(fields: [professor_id], references: [id])
  usuario                  Usuario                       @relation(fields: [usuario_id], references: [id])
  avaliacoes               AvaliacaoFisica[]
  avaliacoesSistema        AvaliacaoSistema[]
  correlacao               CorrelacaoDesempenho?
  medidas                  MedidaCorporal[]
  mensagensEnviadas        MensagemMotivacionalEnviada[]
  notificacoes             Notificacao[]
  treinos                  Treino[]
  wearableIntegracoes      WearableIntegracao[]
  wearableEventos          WearableEvento[]

  @@map("alunos")
}

model Treino {
  id                        String              @id @default(cuid())
  aluno_id                  String
  nome                      String
  dias_semana               Int[]
  status                    TreinoStatus        @default(CADASTRADO)
  iniciado_em               DateTime?
  finalizado_em             DateTime?
  criado_em                 DateTime            @default(now())
  atualizado_em             DateTime            @updatedAt
  avaliacao_dificuldade     String?
  nota_avaliacao            Int?
  feedback_comentario       String?
  is_template               Boolean             @default(false)
  criado_por_ia             Boolean             @default(false)
  /// Evita spam do push de ociosidade
  notificado_inatividade_em DateTime?
  /// Push único quando sessão passa de 60 min
  notificado_longo_em       DateTime?
  /// Push único de lembrete quando sessão fica parada 30 min
  notificado_concluir_em    DateTime?
  /// Última interação na sessão (início ou série registrada)
  ultima_atividade_em       DateTime?
  execucoes                 ExecucaoExercicio[]
  exercicios                TreinoExercicio[]
  historico                 TreinoHistorico[]
  aluno                     Aluno               @relation(fields: [aluno_id], references: [id])

  @@map("treinos")
}

/// Log imutável de transições de estado — append-only
model TreinoHistorico {
  id               String       @id @default(cuid())
  treino_id        String
  status_anterior  TreinoStatus
  status_novo      TreinoStatus
  ator_id          String
  ator_tipo        TreinoAtor
  timestamp                  DateTime     @default(now())
  duracao_segundos           Int?
  calorias_queimadas          Float?
  frequencia_cardiaca_media  Int?
  frequencia_cardiaca_maxima Int?
  nota_avaliacao             Int?
  feedback_comentario        String?
  treino                     Treino       @relation(fields: [treino_id], references: [id])

  @@map("treino_historico")
}

model Exercicio {
  id                      String                 @id @default(cuid())
  nome                    String
  maquina                 String?
  dica                    String?
  imagem_url              String?
  criado_em               DateTime               @default(now())
  atualizado_em           DateTime               @updatedAt
  equipamento             String?
  grupo_muscular          String?
  nivel                   String?
  descricao_pt            String?
  gif_url                 String?
  musculo_alvo            String?
  musculos_secundarios    String[]
  passos_pt               String[]
  execucoes               ExecucaoExercicio[]
  planoSessaoAlternativos PlanoSessaoExercicio[] @relation("ExercicioAlternativo")
  planoSessaoExercicios   PlanoSessaoExercicio[] @relation("ExercicioBase")
  treinos                 TreinoExercicio[]

  @@map("exercicios")
}

/// Associação Treino ↔ Exercício com ordem, séries e reps prescritas
model TreinoExercicio {
  id                      String    @id @default(cuid())
  treino_id               String
  exercicio_id            String
  ordem                   Int
  series                  Int       @default(3)
  repeticoes              Int       @default(12)
  carga_sugerida_kg       Float?
  tipo                    String    @default("PRINCIPAL")
  metodo                  String    @default("TRADICIONAL")
  bloco_grupo             Int?
  tempo_descanso_segundos Int?      @default(60)
  observacoes             String?
  exercicio               Exercicio @relation(fields: [exercicio_id], references: [id])
  treino                  Treino    @relation(fields: [treino_id], references: [id])

  @@unique([treino_id, ordem])
  @@map("treino_exercicios")
}

model PlanoBiblioteca {
  id              String        @id @default(cuid())
  codigo          String        @unique
  nome            String
  descricao       String?
  objetivo        String
  nivel           String
  sexo_alvo       String        @default("AMBOS")
  dias_por_semana Int
  split_tipo      String
  ativo           Boolean       @default(true)
  criado_em       DateTime      @default(now())
  sessoes         PlanoSessao[]

  @@map("planos_biblioteca")
}

model PlanoSessao {
  id         String                 @id @default(cuid())
  plano_id   String
  nome       String
  dia_label  String
  ordem      Int
  exercicios PlanoSessaoExercicio[]
  plano      PlanoBiblioteca        @relation(fields: [plano_id], references: [id], onDelete: Cascade)

  @@map("plano_sessoes")
}

model PlanoSessaoExercicio {
  id                       String      @id @default(cuid())
  sessao_id                String
  exercicio_id             String
  ordem                    Int
  tipo                     String      @default("PRINCIPAL")
  series                   Int         @default(3)
  repeticoes_min           Int         @default(8)
  repeticoes_max           Int         @default(12)
  carga_sugerida_kg        Float?
  restricoes_incompativeis String[]    @default([])
  alternativo_id           String?
  alternativo              Exercicio?  @relation("ExercicioAlternativo", fields: [alternativo_id], references: [id])
  exercicio                Exercicio   @relation("ExercicioBase", fields: [exercicio_id], references: [id])
  sessao                   PlanoSessao @relation(fields: [sessao_id], references: [id], onDelete: Cascade)

  @@unique([sessao_id, ordem])
  @@map("plano_sessao_exercicios")
}

/// Registro de execução real pelo aluno (carga e reps realizadas)
model ExecucaoExercicio {
  id            String    @id @default(cuid())
  treino_id     String
  exercicio_id  String
  serie_numero  Int
  repeticoes    Int
  carga_kg      Float
  rpe           Int?      /// UX-010: Percepção subjetiva de esforço (1-10) informada pelo aluno
  registrado_em DateTime  @default(now())
  exercicio     Exercicio @relation(fields: [exercicio_id], references: [id])
  treino        Treino    @relation(fields: [treino_id], references: [id])

  @@map("execucao_exercicios")
}

model MedidaCorporal {
  id             String   @id @default(cuid())
  aluno_id       String
  peso_kg        Float?
  altura_cm      Float?
  percentual_bf  Float?
  massa_magra_kg Float?
  data           DateTime @default(now())
  observacao     String?
  imc            Float?
  aluno          Aluno    @relation(fields: [aluno_id], references: [id])

  @@map("medidas_corporais")
}

model Notificacao {
  id        String          @id @default(cuid())
  aluno_id  String
  tipo      NotificacaoTipo
  mensagem  String
  dados     Json?
  lida      Boolean         @default(false)
  criado_em DateTime        @default(now())
  aluno     Aluno           @relation(fields: [aluno_id], references: [id])

  @@map("notificacoes")
}

model MensagemMotivacional {
  id         String                        @id @default(cuid())
  titulo     String
  resumo     String
  url_estudo String
  criado_em  DateTime                      @default(now())
  enviadas   MensagemMotivacionalEnviada[]

  @@map("mensagens_motivacionais")
}

/// Controle de rotação circular por aluno (UC-28 / UC-33)
model MensagemMotivacionalEnviada {
  id          String               @id @default(cuid())
  aluno_id    String
  mensagem_id String
  enviada_em  DateTime             @default(now())
  aluno       Aluno                @relation(fields: [aluno_id], references: [id])
  mensagem    MensagemMotivacional @relation(fields: [mensagem_id], references: [id])

  @@map("mensagens_motivacionais_enviadas")
}

/// Notícias de bem-estar / atividade física sincronizadas via RSS do Google News
model Noticia {
  id              String            @id @default(cuid())
  titulo          String
  resumo          String
  url             String            @unique
  fonte           String?
  imagem_url      String?
  data_publicacao DateTime?
  criado_em       DateTime          @default(now())
  enviadas        NoticiaEnviada[]

  @@map("noticias")
}

/// Controle de rotação circular por usuário — evita reenviar a mesma notícia
model NoticiaEnviada {
  id         String   @id @default(cuid())
  usuario_id String
  noticia_id String
  enviada_em DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])
  noticia    Noticia  @relation(fields: [noticia_id], references: [id])

  @@unique([usuario_id, noticia_id])
  @@map("noticias_enviadas")
}

/// Cache de correlações (UC-32) — worker recalcula, endpoint lê
/// Sugere atualização quando calculado_em > 30 dias
model CorrelacaoDesempenho {
  id                   String   @id @default(cuid())
  aluno_id             String   @unique
  peso_volume_r        Float?
  bf_volume_r          Float?
  massa_magra_volume_r Float?
  volume_semanal       Json
  pontos               Json
  calculado_em         DateTime @default(now())
  aluno                Aluno    @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  @@map("correlacoes_desempenho")
}

model SocialFriendship {
  id        String           @id @default(cuid())
  aluno_id  String
  amigo_id  String
  status    FriendshipStatus @default(PENDENTE)
  criado_em DateTime         @default(now())

  @@unique([aluno_id, amigo_id])
  @@index([amigo_id, status])
  @@map("social_friendships")
}

model SocialPost {
  id                    String           @id @default(cuid())
  aluno_id              String
  treino_id             String?
  clube_id              String?
  autor_nome            String
  autor_foto_url        String?
  grupo_muscular_resumo String?
  tipo                  PostTipo
  visibilidade          Visibilidade
  midia_url             String?
  legenda               String?
  curtidas_count        Int              @default(0)
  comentarios_count     Int              @default(0)
  criado_em             DateTime         @default(now())
  academia_nome         String?
  post_clubes           SocialPostClub[]

  @@index([aluno_id, criado_em])
  @@index([clube_id, criado_em])
  @@index([visibilidade, criado_em])
  @@map("social_posts")
}

model SocialLike {
  id        String   @id @default(cuid())
  post_id   String
  aluno_id  String
  criado_em DateTime @default(now())

  @@unique([post_id, aluno_id])
  @@index([post_id])
  @@map("social_likes")
}

model SocialComment {
  id         String   @id @default(cuid())
  post_id    String
  aluno_id   String
  autor_nome String
  texto      String   @db.VarChar(280)
  criado_em  DateTime @default(now())

  @@index([post_id, criado_em])
  @@map("social_comments")
}

model SocialClub {
  id            String              @id @default(cuid())
  academia_id   String?             @unique
  nome          String
  tipo          ClubTipo            @default(ACADEMIA)
  codigo_convite String?             @unique
  descricao     String?
  criado_em     DateTime            @default(now())
  membros       SocialClubMember[]
  posts         SocialPostClub[]

  @@map("social_clubs")
}

model SocialClubMember {
  id           String          @id @default(cuid())
  clube_id     String
  aluno_id     String
  xp_semana    Int             @default(0)
  criado_em    DateTime        @default(now())
  xp_reset_ano Int             @default(2026)
  role         ClubMemberRole  @default(MEMBRO)
  clube        SocialClub      @relation(fields: [clube_id], references: [id], onDelete: Cascade)

  @@unique([clube_id, aluno_id])
  @@index([clube_id, xp_semana])
  @@map("social_club_members")
}

model SocialPostClub {
  post_id  String
  clube_id String
  post     SocialPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  clube    SocialClub @relation(fields: [clube_id], references: [id], onDelete: Cascade)

  @@id([post_id, clube_id])
  @@map("social_post_clubes")
}

model AvaliacaoFisica {
  id                 String          @id @default(cuid())
  aluno_id           String
  avaliador_id       String
  data               DateTime        @default(now())
  status             AvaliacaoStatus @default(CONCLUIDA)
  parq_positivo      Boolean         @default(false)
  risco_cardiaco     RiscoCardiaco   @default(BAIXO)
  liberado_teste_max Boolean         @default(true)
  anamnese_json      Json?
  pas                Int?
  pad                Int?
  fc_repouso         Int?
  peso_kg            Float?
  estatura_m         Float?
  imc                Float?
  rcq                Float?
  perimetros_cm      Json?
  protocolo_dobras   String?
  soma_dobras_mm     Float?
  densidade_corporal Float?
  percentual_gordura Float?
  massa_gorda_kg     Float?
  massa_magra_kg     Float?
  classificacao_gc   String?
  postural_json      Json?
  flexibilidade_json Json?
  cardio_json        Json?
  neuro_json         Json?
  laudo_markdown     String?
  prescricao_json    Json?
  criado_em          DateTime        @default(now())
  atualizado_em      DateTime        @updatedAt
  aluno              Aluno           @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  avaliador          Usuario         @relation(fields: [avaliador_id], references: [id])
  fotos              AvaliacaoFoto[]

  @@index([aluno_id])
  @@index([avaliador_id])
  @@map("avaliacoes_fisicas")
}

model AvaliacaoFoto {
  id            String          @id @default(cuid())
  avaliacao_id  String
  url           String
  nome_arquivo  String
  mime_type     String          @map("mimetype")
  tamanho_bytes Int
  criado_em     DateTime        @default(now())
  avaliacao     AvaliacaoFisica @relation(fields: [avaliacao_id], references: [id], onDelete: Cascade)

  @@index([avaliacao_id])
  @@map("avaliacoes_fotos")
}

/// Avaliação pós-treino do sistema — nota + respostas do questionário
model AvaliacaoSistema {
  id        String   @id @default(cuid())
  aluno_id  String
  nota      Int
  respostas Json
  mensagem  String?
  criado_em DateTime @default(now())
  aluno     Aluno    @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  @@index([aluno_id])
  @@map("avaliacoes_sistema")
}

enum Role {
  ROOT
  ACADEMIA
  PROFESSOR
  ALUNO
}

enum AcademiaStatus {
  PENDENTE
  ATIVO
  REJEITADO
}

enum Sexo {
  MASCULINO
  FEMININO
}

/// Aprovação em duas camadas: Academia → Root
enum VinculoStatus {
  PENDENTE_ACADEMIA
  PENDENTE_ROOT
  ATIVO
  REJEITADO
  REMOVIDO
}

enum TreinoStatus {
  CADASTRADO
  ENVIADO
  ACEITO
  RECUSADO
  EM_ABERTO
  EM_EXECUCAO
  CONCLUIDO
}

enum TreinoAtor {
  ALUNO
  PROFESSOR
  SISTEMA
  ACADEMIA
}

model WearableIntegracao {
  id                String    @id @default(cuid())
  aluno_id          String
  provedor          String    // "huawei" | "garmin" | "polar" | "fitbit" | "oura" | "health_connect"
  user_id_ext       String    // ID do usuário no sistema do provedor / Open Wearables
  access_token_enc  String?   // Token criptografado
  refresh_token_enc String?   // Refresh token criptografado
  token_expira_em   DateTime?
  ativo             Boolean   @default(true)
  criado_em         DateTime  @default(now())
  atualizado_em     DateTime  @updatedAt
  aluno             Aluno     @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  @@unique([aluno_id, provedor])
  @@map("wearable_integracoes")
}

model WearableEvento {
  id          String   @id @default(cuid())
  aluno_id    String
  provedor    String
  tipo        String   // "weight" | "workout" | "heart_rate" | "body_fat" | "sleep" | "vo2max"
  payload_raw Json
  processado  Boolean  @default(false)
  erro_msg    String?
  recebido_em DateTime @default(now())
  aluno       Aluno    @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  @@index([aluno_id, recebido_em])
  @@map("wearable_eventos")
}

enum NotificacaoTipo {
  PROFESSOR_ATRIBUIDO
  NOVO_TREINO
}

enum FriendshipStatus {
  PENDENTE
  ACEITO
  BLOQUEADO
}

enum PostTipo {
  TREINO_INICIADO
  TREINO_CONCLUIDO
  RECORDE_PESSOAL
  BADGE_CONQUISTADO
  DESAFIO_COMPLETO
}

enum Visibilidade {
  AMIGOS
  PUBLICO
  PRIVADO
}

enum ClubTipo {
  ACADEMIA
  TEMATICO
}

enum ClubMemberRole {
  CRIADOR
  MEMBRO
}

enum AvaliacaoStatus {
  RASCUNHO
  CONCLUIDA
}

enum RiscoCardiaco {
  BAIXO
  MODERADO
  ALTO
}

/// ─── Módulo de Assinaturas (B2C/B2B) ───────────────────────────────────────

enum AssinaturaStatus {
  PENDENTE // checkout iniciado, aguardando confirmação do gateway (assinatura de cartão "pending" ou 1ª cobrança Pix/boleto ainda não paga)
  ATIVA
  EM_CARENCIA
  EXPIRADA
  CANCELADA
  REVOGADA
}

enum AssinaturaOrigem {
  PROPRIA
  PATROCINADA
  MANUAL
}

enum Loja {
  GOOGLE_PLAY
  APPLE_STORE
  WEB_MERCADOPAGO
  MANUAL
}

/// A quem (perfil) uma Assinatura B2B pertence: professor.id | academia.id | aluno.id
enum TenantTipo {
  PROFESSOR
  ACADEMIA
  ALUNO
}

enum CobrancaStatus {
  PENDENTE
  PAGA
  VENCIDA
  ESTORNADA
  CANCELADA
}

enum MetodoPagamentoTipo {
  CARTAO
  PIX
  BOLETO
}

enum ConviteStatus {
  PENDENTE
  USADO
  EXPIRADO
  REVOGADO
}

/// Planos de assinatura disponíveis no sistema
model PlanoAssinatura {
  id                     String        @id @default(cuid())
  codigo                 String        @unique
  nome                   String
  descricao              String?
  papel_alvo             Role
  preco_mensal_cents     Int
  moeda                  String        @default("BRL")
  google_play_product_id String?       @unique
  trial_dias             Int           @default(15)
  limite_alunos          Int?          // legado — mantido como fallback; faixa é a fonte de verdade a partir daqui
  ativo                  Boolean       @default(true)
  criado_em              DateTime      @default(now())
  // ── faixas por quantidade de alunos ativos (30d) — Personal/Academia ──
  faixa_min_alunos            Int      @default(0)
  faixa_max_alunos            Int?     // null = ilimitado
  professores_inclusos        Int      @default(1)
  unidades_inclusas           Int      @default(1)
  preco_aluno_excedente_cents Int?     // cobrança linear por aluno acima do teto (alternativa a auto-upgrade de faixa)
  recursos                    Json     @default("{}") // flags de feature: relatorios, white_label, multiunidade...
  gateway_product_id          String?  // preapproval_plan_id do Mercado Pago, quando aplicável
  ordem                        Int     @default(0) // ordenação de exibição em /planos
  assinaturas            Assinatura[]

  @@map("planos_assinatura")
}

/// Assinatura ativa de um usuário (própria, patrocinada ou manual)
model Assinatura {
  id                       String            @id @default(cuid())
  usuario_id               String
  plano_id                 String
  loja                     Loja              @default(GOOGLE_PLAY)
  origem                   AssinaturaOrigem   @default(PROPRIA)
  status                   AssinaturaStatus   @default(ATIVA)
  google_purchase_token    String?             @unique
  google_order_id          String?
  inicio_em                DateTime?
  expires_at               DateTime?
  trial_iniciado_em        DateTime?
  trial_fim_em             DateTime?
  auto_renovating          Boolean           @default(true)
  cancelada_em             DateTime?
  motivo_revogacao         Json?
  patrocinada_por_usuario_id String?
  criado_em                DateTime          @default(now())
  atualizado_em            DateTime          @updatedAt
  // ── Mercado Pago / B2B por faixa (payer sempre pessoa física — ver docs/planning/integracao-mercado-pago.md) ──
  tenant_tipo              TenantTipo?
  tenant_id                String?           // professor.id | academia.id | aluno.id
  faixa_alunos_inclusos    Int?
  faixa_alunos_max         Int?
  valor_mensal_cents       Int?              // preço congelado no ciclo vigente
  alunos_excedentes        Int               @default(0)
  metodo_pagamento_id      String?
  gateway_customer_id      String?           // customer_id do Mercado Pago
  gateway_subscription_id  String?           @unique // preapproval_id (cartão recorrente)
  proxima_cobranca_em      DateTime?
  congelamento_ate         DateTime?         // faixa congelada (plano anual)
  usuario                  Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  plano                    PlanoAssinatura   @relation(fields: [plano_id], references: [id])
  metodoPagamento          PagamentoMetodo?  @relation(fields: [metodo_pagamento_id], references: [id])
  eventos                  AssinaturaEvento[]
  cobrancas                Cobranca[]

  @@index([usuario_id])
  @@index([patrocinada_por_usuario_id, status])
  @@index([status, expires_at])
  @@index([tenant_tipo, tenant_id])
  @@map("assinaturas")
}

/// Log imutável de eventos recebidos do webhook (RTDN/Mercado Pago) ou manuais
model AssinaturaEvento {
  id                String      @id @default(cuid())
  assinatura_id     String?
  purchase_token    String?
  tipo_evento       String
  payload           Json
  processado        Boolean     @default(false)
  erro              String?
  recebido_em       DateTime    @default(now())
  gateway           String?
  evento_externo_id String?     @unique // id da notificação do gateway — dedupe de reentrega
  assinatura        Assinatura? @relation(fields: [assinatura_id], references: [id], onDelete: Cascade)

  @@index([purchase_token])
  @@index([assinatura_id, recebido_em])
  @@map("assinatura_eventos")
}

/// Snapshot mensal de uso por tenant (base da faixa e da fatura) — Personal/Academia
model UsoMensal {
  id                  String     @id @default(cuid())
  tenant_tipo         TenantTipo
  tenant_id           String
  competencia         String                // "2026-09"
  alunos_ativos       Int        @default(0)
  alunos_vinculados   Int        @default(0)
  professores_ativos  Int        @default(0)
  unidades            Int        @default(1)
  storage_bytes       BigInt     @default(0)
  faixa_plano_codigo  String?
  valor_cents         Int        @default(0)
  calculado_em        DateTime   @default(now())

  @@unique([tenant_tipo, tenant_id, competencia])
  @@index([competencia])
  @@map("uso_mensal")
}

/// Fatura/cobrança de um ciclo (histórico exibido em /billing/faturas)
model Cobranca {
  id                String         @id @default(cuid())
  assinatura_id     String
  competencia       String
  valor_cents       Int
  status            CobrancaStatus @default(PENDENTE)
  vencimento        DateTime
  pago_em           DateTime?
  gateway           String?        @default("mercadopago")
  gateway_charge_id String?        @unique // payment_id do Mercado Pago
  mp_preapproval_id String?
  pix_copia_cola    String?        @db.Text
  pix_qr_base64     String?        @db.Text
  boleto_url        String?
  linha_digitavel   String?
  // ── fiscal, opcional — só se o assinante pedir nota (fluxo futuro, ver §9 do doc de integração) ──
  nfse_numero       String?
  nfse_url          String?
  cliente_cnpj      String?
  tentativas        Int            @default(0)
  criado_em         DateTime       @default(now())
  atualizado_em     DateTime       @updatedAt
  assinatura        Assinatura     @relation(fields: [assinatura_id], references: [id], onDelete: Cascade)

  @@index([assinatura_id, competencia])
  @@index([status, vencimento])
  @@map("cobrancas")
}

/// Método de pagamento tokenizado (nunca guardar PAN)
model PagamentoMetodo {
  id                  String               @id @default(cuid())
  usuario_id          String
  gateway             String               @default("mercadopago")
  gateway_customer_id String?
  tipo                MetodoPagamentoTipo  @default(CARTAO)
  cartao_ultimos4     String?
  cartao_bandeira     String?
  token               String?              // card_id do Mercado Pago — nunca o número do cartão
  padrao              Boolean              @default(true)
  criado_em           DateTime             @default(now())
  usuario             Usuario              @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  assinaturas         Assinatura[]

  @@index([usuario_id])
  @@map("pagamentos_metodo")
}

/// Convite de professor para aluno (uso único, 7 dias)
model ConviteAluno {
  id            String        @id @default(cuid())
  professor_id  String
  token         String        @unique
  status        ConviteStatus @default(PENDENTE)
  expira_em     DateTime
  aluno_id      String?       @unique
  criado_em     DateTime      @default(now())
  atualizado_em DateTime      @updatedAt
  professor     Usuario       @relation("ConvitesCriados", fields: [professor_id], references: [id])
  aluno         Usuario?      @relation("ConviteUtilizado", fields: [aluno_id], references: [id])

  @@index([token])
  @@index([professor_id, status])
  @@map("convites_aluno")
}
