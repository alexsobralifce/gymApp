{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx prisma generate && tsc -p tsconfig.json",
    "watchPatterns": [
      "apps/api/**",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "startCommand": "bash railway-start.sh",
    "restartPolicyType": "ALWAYS"
  }
}
